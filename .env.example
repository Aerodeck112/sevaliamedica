APP_NAME="SEVALIA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Bucharest
APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

# Cheie HMAC pentru indexul de căutare al identificatorilor (CNP). Generată la instalare, diferită de APP_KEY.
SEVALIA_BLIND_INDEX_KEY=
# Directorul „shared” din afara public_html (în producție: /home/<cont>/sevalia/shared)
SEVALIA_SHARED_PATH=
# Mediu: production | staging | local (staging afișează o bandă de avertizare și blochează trimiterile reale)
SEVALIA_STAGE=local

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sevalia
DB_USERNAME=sevalia
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="office@sevalia.ro"
MAIL_FROM_NAME="SEVALIA"
